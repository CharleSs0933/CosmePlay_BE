// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  STAFF
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      Role     @default(USER)
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Review  Review[]
  Cart    Cart?
  Address Address[]
  Order   Order[]
  Post    Post[]
  Voucher Voucher[]
}

model Address {
  id             String  @id @default(uuid())
  user_id        String
  address        String
  to_city_id     String?
  to_ward_code   String?
  to_district_id String?
  city           String
  pincode        String
  phone          String
  notes          String?

  user  User    @relation(fields: [user_id], references: [id])
  Order Order[]
}

model Product {
  id                  String   @id @default(uuid())
  title               String
  description         String?
  price               Float
  sale_price          Float?
  image_url           String?
  images              String[]
  rating              Float    @default(0)
  total_stock         Int      @default(0)
  product_category_id String
  product_brand_id    String
  product_skinType_id String
  stripe_product_id   String?  @unique
  stripe_price_id     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  productCategory ProductCategory  @relation(fields: [product_category_id], references: [id])
  productBrand    ProductBrand     @relation(fields: [product_brand_id], references: [id])
  productSkinType ProductSkinType? @relation(fields: [product_skinType_id], references: [id])
  Review          Review[]
  CartLineItem    CartLineItem[]
  OrderItem       OrderItem[]
  Batch           Batch[]
  VoucherProduct  VoucherProduct[]
}

model Batch {
  id            String   @id @default(uuid())
  product_id    String
  quantity      Int
  current_stock Int
  expired_at    DateTime
  created_at    DateTime @default(now())

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
}

model ProductCategory {
  id          String  @id @default(uuid())
  title       String  @unique
  description String?

  Product Product[]
  Post    Post?
}

model ProductBrand {
  id          String  @id @default(uuid())
  title       String
  description String?

  Product Product[]
}

model ProductSkinType {
  id          String  @id @default(uuid())
  title       String
  description String?

  Product Product[]
}

model Review {
  id             String   @id @default(uuid())
  user_id        String
  product_id     String
  user_name      String
  review_value   Int
  review_message String?
  createdAt      DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])
}

model Cart {
  id      String @id @default(uuid())
  user_id String

  user      User           @relation(fields: [user_id], references: [id])
  cartItems CartLineItem[]

  @@unique([user_id]) // Ensures a user can have only one cart
}

model CartLineItem {
  id         String @id @default(uuid())
  cart_id    String
  product_id String
  quantity   Int    @default(1)

  cart    Cart    @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
}

model Order {
  id                  String      @id @default(uuid())
  user_id             String
  address_id          String
  status              OrderStatus
  total_amount        Int
  checkout_session_id String
  payment_intent_id   String
  payment_method      String
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user       User        @relation(fields: [user_id], references: [id])
  address    Address     @relation(fields: [address_id], references: [id])
  voucher    Voucher?
  orderItems OrderItem[]
}

model OrderItem {
  id         String @id @default(uuid())
  order_id   String
  product_id String

  title     String
  price     Float
  image_url String?
  quantity  Int

  order   Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id])
}

model Post {
  id            String   @id @default(uuid())
  category_id   String
  author_id     String
  title         String
  thumbnail_url String
  description   String?
  warnings      String[]
  benefits      String[]

  author    User            @relation(fields: [author_id], references: [id])
  category  ProductCategory @relation(fields: [category_id], references: [id])
  postSteps PostStep[]

  @@unique([category_id])
}

model PostStep {
  id          String   @id @default(uuid())
  title       String
  description String?
  details     String
  image_url   String?
  tips        String[]
  post_id     String

  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)
}

enum OrderStatus {
  PROCESSING
  SHIPPED
  DELIVERD
  CANCELLED
}

model Event {
  id          String    @id @default(uuid())
  title       String
  description String?
  start_time  DateTime
  end_time    DateTime
  type        EventType @default(QUIZ)
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())

  questions   Question[]
  eventReward EventReward[]
}

enum EventType {
  QUIZ
  DROP
}

model Question {
  id        String  @id @default(uuid())
  event_id  String
  content   String
  image_url String?

  event           Event            @relation(fields: [event_id], references: [id], onDelete: Cascade)
  questionOptions QuestionOption[]
}

model QuestionOption {
  id          String  @id @default(uuid())
  question_id String
  content     String
  is_correct  Boolean @default(false)

  question Question @relation(fields: [question_id], references: [id], onDelete: Cascade)
}

enum RewardType {
  PERCENT
  AMOUNT
}

model EventReward {
  id               String     @id @default(uuid())
  event_id         String
  min_correct      Int
  max_correct      Int
  voucher_quantity Int        @default(1)
  discount_value   Float
  type             RewardType @default(PERCENT)

  vouchers Voucher[]
  event    Event     @relation(fields: [event_id], references: [id], onDelete: Cascade)
}

model Voucher {
  id               String     @id @default(uuid())
  user_id          String
  event_reward_id  String?
  stripe_coupon_id String     @unique
  order_id         String?    @unique
  discount_value   Float
  duration         Int        @default(48)
  type             RewardType @default(PERCENT)
  redeemed         Boolean    @default(false)
  redeemed_at      DateTime?
  created_at       DateTime   @default(now())

  user            User             @relation(fields: [user_id], references: [id])
  eventReward     EventReward?     @relation(fields: [event_reward_id], references: [id], onDelete: SetNull)
  voucherProducts VoucherProduct[]
  Order           Order?           @relation(fields: [order_id], references: [id])
}

model VoucherProduct {
  id         String @id @default(uuid())
  voucher_id String
  product_id String

  voucher Voucher @relation(fields: [voucher_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([voucher_id, product_id]) // Ensures a voucher can have a product only once
}
