// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  STAFF
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      Role     @default(USER)
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Review  Review[]
  Cart    Cart?
  Address Address[]
  Order   Order[]
}

model Address {
  id      String  @id @default(uuid())
  user_id String
  address String
  city    String
  pincode String
  phone   String
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User    @relation(fields: [user_id], references: [id])
  Order Order[]
}

model Product {
  id                  String   @id @default(uuid())
  title               String
  description         String?
  price               Float
  sale_price          Float?
  image_url           String?
  rating              Float    @default(0)
  total_stock         Int      @default(0)
  product_category_id String
  product_brand_id    String
  product_skinType_id String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  productCategory ProductCategory  @relation(fields: [product_category_id], references: [id])
  productBrand    ProductBrand     @relation(fields: [product_brand_id], references: [id])
  productSkinType ProductSkinType? @relation(fields: [product_skinType_id], references: [id])
  Review          Review[]
  CartLineItem    CartLineItem[]
  OrderItem       OrderItem[]
}

model ProductCategory {
  id          String  @id @default(uuid())
  title       String
  description String?

  Product Product[]
}

model ProductBrand {
  id          String  @id @default(uuid())
  title       String
  description String?

  Product Product[]
}

model ProductSkinType {
  id          String  @id @default(uuid())
  title       String
  description String?

  Product Product[]
}

model Review {
  id             String   @id @default(uuid())
  user_id        String
  product_id     String
  user_name      String
  review_value   Int
  review_message String?
  createdAt      DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])
}

model Cart {
  id      String @id @default(uuid())
  user_id String

  user      User           @relation(fields: [user_id], references: [id])
  cartItems CartLineItem[]

  @@unique([user_id]) // Ensures a user can have only one cart
}

model CartLineItem {
  id         String @id @default(uuid())
  cart_id    String
  product_id String
  quantity   Int    @default(1)

  cart    Cart    @relation(fields: [cart_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])
}

model Order {
  id                  String      @id @default(uuid())
  user_id             String
  address_id          String
  status              OrderStatus
  total_amount        Int
  checkout_session_id String
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user       User        @relation(fields: [user_id], references: [id])
  address    Address     @relation(fields: [address_id], references: [id])
  orderItems OrderItem[]
}

model OrderItem {
  id         String @id @default(uuid())
  order_id   String
  product_id String

  title     String
  price     Float
  image_url String?
  quantity  Int

  order   Order   @relation(fields: [order_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])
}

enum OrderStatus {
  PROCESSING
  SHIPPED
  DELIVERD
  CANCELLED
}
