// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  STAFF
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      Role     @default(USER)
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Review     Review[]
  Cart       Cart?
  Address    Address[]
  Order      Order[]
  Post       Post[]
  Batch      Batch[]
  Voucher    Voucher[]
  EventScore EventScore[]
}

model Address {
  id             String  @id @default(uuid())
  user_id        String
  address        String
  to_city_id     String?
  to_ward_code   String?
  to_district_id String?
  city           String
  pincode        String
  full_name      String
  phone          String
  notes          String?

  user  User    @relation(fields: [user_id], references: [id])
  Order Order[]
}

model Product {
  id                  String      @id @default(uuid())
  product_code        String      @unique
  title               String
  description         String?
  volume              Float?
  ingredients         String?
  volume_type         VolumeType?
  price               Float
  sale_price          Float?
  image_url           String?
  images              String[]
  rating              Float       @default(0)
  total_stock         Int         @default(0)
  product_category_id String
  product_brand_id    String
  product_skinType_id String
  stripe_product_id   String?     @unique
  stripe_price_id     String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  productCategory ProductCategory  @relation(fields: [product_category_id], references: [id])
  productBrand    ProductBrand     @relation(fields: [product_brand_id], references: [id])
  productSkinType ProductSkinType? @relation(fields: [product_skinType_id], references: [id])
  Review          Review[]
  CartLineItem    CartLineItem[]
  OrderItem       OrderItem[]
  Batch           Batch[]
  VoucherProduct  VoucherProduct[]
}

enum VolumeType {
  ML
  GRAM
  PIECE
}

model Batch {
  id            String   @id @default(uuid())
  product_id    String
  user_id       String?
  supplier_id   String?
  quantity      Int
  current_stock Int
  expired_at    DateTime
  created_at    DateTime @default(now())

  user     User?     @relation(fields: [user_id], references: [id])
  supplier Supplier? @relation(fields: [supplier_id], references: [id])
  product  Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
}

model Supplier {
  id             String  @id @default(uuid())
  name           String
  contact_person String?
  email          String? @unique
  phone          String? @unique
  address        String?
  company_name   String?
  note           String?

  Batch Batch[]
}

model ProductCategory {
  id          String  @id @default(uuid())
  title       String  @unique
  description String?

  Product Product[]
  Post    Post?
}

model ProductBrand {
  id          String  @id @default(uuid())
  title       String
  description String?

  Product Product[]
}

model ProductSkinType {
  id          String  @id @default(uuid())
  title       String
  description String?

  Product Product[]
}

model Review {
  id             String   @id @default(uuid())
  user_id        String
  product_id     String
  user_name      String
  review_value   Int
  review_message String?
  createdAt      DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])
}

model Cart {
  id      String @id @default(uuid())
  user_id String

  user      User           @relation(fields: [user_id], references: [id])
  cartItems CartLineItem[]

  @@unique([user_id]) // Ensures a user can have only one cart
}

model CartLineItem {
  id         String @id @default(uuid())
  cart_id    String
  product_id String
  quantity   Int    @default(1)

  cart    Cart    @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
}

model Order {
  id           String @id @default(uuid())
  order_number String @unique

  user_id    String
  address_id String
  status     OrderStatus

  // Chi tiết các khoản tiền
  subtotal        Float // Tổng tiền hàng (chưa giảm giá)
  discount_amount Float @default(0) // Số tiền được giảm
  shipping_fee    Float @default(0) // Phí vận chuyển
  total_amount    Float // Tổng tiền cuối cùng

  // Thông tin thanh toán
  checkout_session_id String?
  payment_intent_id   String?
  payment_method      String?
  payment_status      PaymentStatus
  receipt_url         String? // URL của biên lai thanh toán

  // Thông tin voucher
  voucher_id String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [user_id], references: [id])
  address    Address     @relation(fields: [address_id], references: [id])
  orderItems OrderItem[]
  voucher    Voucher?

  @@unique([user_id, order_number]) // Ensures a user can have only one order with a specific order number
}

enum PaymentStatus {
  PAID
  REFUNDED
}

model OrderItem {
  id         String @id @default(uuid())
  order_id   String
  product_id String

  // Thông tin sản phẩm tại thời điểm đặt hàng
  title     String
  image_url String?
  quantity  Int

  // Chi tiết giá cả
  unit_price        Float // Giá gốc của 1 sản phẩm
  discount_per_item Float @default(0) // Giảm giá cho từng item
  final_price       Float // Giá cuối cùng của 1 sản phẩm
  total_price       Float // Tổng tiền cho quantity sản phẩm này

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  order   Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id])
}

model Post {
  id            String   @id @default(uuid())
  category_id   String
  author_id     String
  title         String
  thumbnail_url String
  description   String?
  warnings      String[]
  benefits      String[]

  author    User            @relation(fields: [author_id], references: [id])
  category  ProductCategory @relation(fields: [category_id], references: [id])
  postSteps PostStep[]

  @@unique([category_id])
}

model PostStep {
  id          String   @id @default(uuid())
  title       String
  description String?
  details     String
  image_url   String?
  tips        String[]
  post_id     String

  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)
}

enum OrderStatus {
  PROCESSING
  SHIPPED
  DELIVERD
  CANCELLED
}

model Event {
  id          String    @id @default(uuid())
  title       String
  description String?
  image_url   String?
  start_time  DateTime
  end_time    DateTime
  type        EventType @default(QUIZ)
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())

  // Mốc điểm để nhận quà
  milestone_score Int @default(100) // Điểm cần đạt để nhận quà

  questions         Question[]
  eventScore        EventScore[]
  leaderboardReward LeaderboardReward[]
  VoucherTemplate   VoucherTemplate[]
}

enum EventType {
  QUIZ
  DROP
  HUNT
  PUZZLE
  REFLEX
  ARCADE
  RACE
  BINGO
  SPIN
  DESIGN
  MEMORY
}

model Question {
  id        String  @id @default(uuid())
  event_id  String
  content   String
  image_url String?

  event           Event            @relation(fields: [event_id], references: [id], onDelete: Cascade)
  questionOptions QuestionOption[]
}

model QuestionOption {
  id          String  @id @default(uuid())
  question_id String
  content     String
  is_correct  Boolean @default(false)

  question Question @relation(fields: [question_id], references: [id], onDelete: Cascade)
}

enum RewardType {
  PERCENT
  AMOUNT
}

model VoucherTemplate {
  id String @id @default(uuid())

  discount_value Float
  type           RewardType @default(PERCENT) // PERCENT | AMOUNT

  user_limit Int? // Số người nhận tối đa
  user_count Int  @default(0) // Số người đã nhận

  voucherProducts VoucherProduct[]
  vouchers        Voucher[] // Theo dõi ai dùng

  is_active Boolean @default(true) // Trạng thái hoạt động của voucher template

  event_id              String?
  leaderboard_reward_id String?
  event                 Event?             @relation(fields: [event_id], references: [id], onDelete: SetNull)
  leaderboardReward     LeaderboardReward? @relation(fields: [leaderboard_reward_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model VoucherProduct {
  id          String @id @default(uuid())
  template_id String
  product_id  String

  voucher VoucherTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([template_id, product_id]) // Ensures a voucher can have a product only once
}

model Voucher {
  id                  String @id @default(uuid())
  voucher_template_id String

  stripe_coupon_id String? @unique // ID của coupon trên Stripe

  user_id  String
  order_id String? @unique // Chỉ cho phép một lần sử dụng voucher cho mỗi đơn hàng

  redeemed    Boolean  @default(false)
  redeemed_at DateTime @default(now())

  user            User            @relation(fields: [user_id], references: [id])
  order           Order?          @relation(fields: [order_id], references: [id])
  voucherTemplate VoucherTemplate @relation(fields: [voucher_template_id], references: [id])

  expired_at DateTime? // Ngày hết hạn của voucher, nếu không có thì voucher sẽ không hết hạn
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
}

model EventScore {
  id       String @id @default(uuid())
  user_id  String
  event_id String
  score    Int // Điểm số đạt được

  // Thông tin bổ sung (optional)
  completion_time Int? // Thời gian hoàn thành (giây) - để tiebreak
  completed_at    DateTime @default(now()) // Thời điểm hoàn thành

  user  User  @relation(fields: [user_id], references: [id])
  event Event @relation(fields: [event_id], references: [id])

  @@unique([user_id, event_id]) // Mỗi user chỉ có 1 điểm cho mỗi event
  @@index([event_id, score]) // Index cho leaderboard
}

model LeaderboardReward {
  id       String @id @default(uuid())
  event_id String

  // Thứ hạng áp dụng
  rank_from Int // Từ thứ hạng
  rank_to   Int // Đến thứ hạng

  // Mô tả phần thưởng
  title       String // Tên phần thưởng (VD: "Top 1", "Top 10")
  description String? // Mô tả chi tiết

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  event            Event             @relation(fields: [event_id], references: [id], onDelete: Cascade)
  voucherTemplates VoucherTemplate[]

  @@index([event_id, rank_from, rank_to])
}
